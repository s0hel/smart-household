generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  PARENT
  CHILD
  GUEST
  READONLY
}

enum TaskType {
  ONE_TIME
  RECURRING
  CHORE
  ROUTINE
}

enum CalendarProvider {
  GOOGLE
  MICROSOFT
  APPLE_CALDAV
}

enum RedemptionStatus {
  PENDING
  APPROVED
  DENIED
}

enum ListType {
  GROCERY
  CUSTOM
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

// Difficulty bands for vocabulary words. JUNIOR targets an early reader
// (~1st grade); ISEE targets the vocabulary section of the ISEE lower/middle
// level exam (~6th grade). Both bands run in parallel every day so a
// household with kids of different ages always has a word for each of them.
enum VocabLevel {
  JUNIOR
  ISEE
}

// ---------------------------------------------------------------------------
// Core tenancy
// ---------------------------------------------------------------------------

model Household {
  id        String   @id @default(cuid())
  name      String
  timezone  String   @default("America/New_York")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  devices          Device[]
  calendarAccounts CalendarAccount[]
  events           Event[]
  tasks            Task[]
  rewards          Reward[]
  lists            List[]
  auditLogs        AuditLog[]
  recipes          Recipe[]
  mealPlanEntries  MealPlanEntry[]
  vocabWords       VocabWord[]
}

model User {
  id        String   @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String

  name      String
  email     String?  @unique
  role      Role
  colorHex  String   @default("#3B82F6")
  avatarUrl String?
  birthdate DateTime?

  // Adults authenticate with a password; children switch profiles via a PIN
  // scoped to an already-authenticated household session (see auth design).
  passwordHash String?
  pinHash      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calendarAccounts   CalendarAccount[]
  assignedEvents     EventAssignee[]
  assignedTasks      Task[]             @relation("TaskAssignee")
  choreCompletions   ChoreCompletion[]  @relation("CompletedBy")
  approvedCompletions ChoreCompletion[] @relation("ApprovedBy")
  redemptions        RewardRedemption[] @relation("RedeemedBy")
  approvedRedemptions RewardRedemption[] @relation("RedemptionApprovedBy")
  auditLogs          AuditLog[]
  mealPlanEntries    MealPlanEntry[]
  vocabReviews       VocabReview[]      @relation("VocabReviewedBy")

  @@index([householdId])
}

model Device {
  id          String    @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String

  name         String
  pairingCode  String?   @unique
  deviceToken  String?   @unique
  pairedAt     DateTime?
  lastSeenAt   DateTime?
  settings     Json      @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
}

// ---------------------------------------------------------------------------
// Calendar
// ---------------------------------------------------------------------------

model CalendarAccount {
  id          String    @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String

  provider       CalendarProvider
  externalId     String?
  accessToken    String?
  refreshToken   String?
  syncCursor     String?
  // The `timeMax` baked into the sync token `syncCursor` holds. Google freezes
  // the originating request's time bounds into the token, so the token stops
  // reporting events past this instant no matter how much later it is used —
  // once now() approaches it, the token has to be discarded and re-baselined
  // against a fresh window. See syncGoogleCalendar.ts.
  syncWindowEnd  DateTime?
  lastSyncedAt   DateTime?
  status         String           @default("disconnected")

  // Google push-notification channel (see server/integrations/calendarWatch.ts).
  // channelId is what the webhook looks the account up by; channelToken is a
  // per-channel secret Google echoes back in X-Goog-Channel-Token, so an
  // unauthenticated POST can be attributed to this account and no other.
  channelId         String?   @unique
  channelResourceId String?
  channelToken      String?
  channelExpiresAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events      Event[]
  sourceLinks EventSourceLink[]

  @@unique([householdId, ownerId, provider])
  @@index([householdId])
}

// Maps a (calendarAccount, providerEventId) pair to the shared Event it
// corresponds to. There can be more than one link per Event — e.g. two
// household members each connect their own Google account and both are
// invited to the same real-world event, so it arrives twice with different
// provider event ids but the same canonicalHash (see dedup logic in
// syncGoogleCalendar.ts) — and this is also how outbound write-back tracks
// which provider-side event id an in-app-created Event maps to per assignee.
model EventSourceLink {
  id String @id @default(cuid())

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String

  calendarAccount   CalendarAccount @relation(fields: [calendarAccountId], references: [id], onDelete: Cascade)
  calendarAccountId String

  sourceEventId String

  createdAt DateTime @default(now())

  @@unique([calendarAccountId, sourceEventId])
  @@index([eventId])
}

model Event {
  id          String    @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String

  title       String
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean   @default(false)
  location    String?
  description String?
  colorHex    String    @default("#3B82F6")
  recurrenceRule String?
  travelTimeMinutes Int?

  calendarAccount   CalendarAccount? @relation(fields: [calendarAccountId], references: [id], onDelete: SetNull)
  calendarAccountId String?
  sourceEventId     String?
  canonicalHash     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignees   EventAssignee[]
  checklist   EventChecklistItem[]
  sourceLinks EventSourceLink[]

  @@unique([calendarAccountId, sourceEventId])
  @@index([householdId, startAt])
  @@index([canonicalHash])
}

model EventAssignee {
  id      String @id @default(cuid())
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String

  @@unique([eventId, userId])
}

model EventChecklistItem {
  id      String  @id @default(cuid())
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String
  label   String
  checked Boolean @default(false)
  order   Int     @default(0)
}

// ---------------------------------------------------------------------------
// Tasks, chores, rewards
// ---------------------------------------------------------------------------

model Task {
  id          String    @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String

  title        String
  type         TaskType
  icon         String?
  assignee     User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId   String?
  frequency    String?
  dueAt        DateTime?
  points       Int       @default(0)
  reward       Reward?   @relation(fields: [rewardId], references: [id], onDelete: SetNull)
  rewardId     String?
  active       Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  completions ChoreCompletion[]

  @@index([householdId])
  @@index([assigneeId])
}

model ChoreCompletion {
  id      String @id @default(cuid())
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId  String

  occurrenceDate DateTime
  completedAt    DateTime @default(now())
  completedBy    User     @relation("CompletedBy", fields: [completedById], references: [id], onDelete: Cascade)
  completedById  String
  pointsAwarded  Int      @default(0)
  approvedAt     DateTime?
  approvedBy     User?    @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedById   String?

  @@unique([taskId, occurrenceDate])
  @@index([completedById])
}

model Reward {
  id          String    @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String

  name              String
  costPoints        Int
  description       String?
  active            Boolean @default(true)
  requiresApproval  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks       Task[]
  redemptions RewardRedemption[]

  @@index([householdId])
}

model RewardRedemption {
  id       String @id @default(cuid())
  reward   Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  rewardId String
  user     User   @relation("RedeemedBy", fields: [userId], references: [id], onDelete: Cascade)
  userId   String

  status       RedemptionStatus @default(PENDING)
  requestedAt  DateTime         @default(now())
  decidedAt    DateTime?
  decidedBy    User?            @relation("RedemptionApprovedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedById  String?

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Lists
// ---------------------------------------------------------------------------

model List {
  id          String    @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String

  name String
  type ListType @default(CUSTOM)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ListItem[]

  @@index([householdId])
}

model ListItem {
  id     String @id @default(cuid())
  list   List   @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId String

  label     String
  quantity  String?
  category  String?
  assigneeId String?
  dueDate   DateTime?
  notes     String?
  checked   Boolean  @default(false)
  order     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listId])
}

// ---------------------------------------------------------------------------
// Meal planning
// ---------------------------------------------------------------------------

model Recipe {
  id          String    @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String

  name         String
  description  String?
  instructions String?
  servings     Int?    @default(4)
  prepMinutes  Int?
  cookMinutes  Int?
  imageUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ingredients     RecipeIngredient[]
  mealPlanEntries MealPlanEntry[]

  @@index([householdId])
}

model RecipeIngredient {
  id       String @id @default(cuid())
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId String

  name     String
  quantity String?
  category String?
  order    Int     @default(0)

  @@index([recipeId])
}

model MealPlanEntry {
  id          String    @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String

  date        DateTime
  mealType    MealType
  recipe      Recipe?   @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  recipeId    String?
  customTitle String?
  notes       String?
  assignee    User?     @relation(fields: [assigneeId], references: [id], onDelete: Cascade)
  assigneeId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // assigneeId is nullable and NULLs don't collide in a Postgres unique
  // index, so this allows one un-assigned ("whole family") entry plus one
  // entry per assignee for the same date/mealType.
  @@unique([householdId, date, mealType, assigneeId])
  @@index([householdId, date])
}

// ---------------------------------------------------------------------------
// Vocabulary ("word of the day")
// ---------------------------------------------------------------------------

// An LLM-generated vocabulary word. The generated content is persisted rather
// than re-derived per request for three reasons: everyone in the household
// (and every device) must see the *same* word and the *same* quiz options on a
// given day, a review has to be scorable against a stable answer key, and
// regenerating on each dashboard poll would burn tokens for text that only
// changes once a day.
model VocabWord {
  id          String    @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String

  word         String
  level        VocabLevel
  partOfSpeech String

  // Two definitions of the same word, written for two different readers, so a
  // 6-year-old and a 10-year-old can look at one card together.
  kidDefinition    String
  simpleDefinition String
  synonyms         String[]
  exampleSentence  String

  // Multiple-choice comprehension check. quizChoices is answer-order-stable
  // (the LLM's own shuffle is persisted) so quizAnswerIndex stays valid for
  // every viewer and every retry.
  quizQuestion    String
  quizChoices     String[]
  quizAnswerIndex Int

  // The day this word is the household's word of the day for its level.
  // NULL marks a *bonus* word pulled on demand ("give me another one"), which
  // is deliberately excluded from the unique index below — Postgres does not
  // collide NULLs, so a household can hold one scheduled word per level per
  // day plus any number of bonus words.
  scheduledFor DateTime?

  // Provenance for a row whose content came from a model, so a bad batch can
  // be traced back to the provider/model that produced it.
  generatedBy String?

  createdAt DateTime @default(now())

  reviews VocabReview[]

  @@unique([householdId, level, scheduledFor])
  @@index([householdId, level, createdAt])
}

// One row per (word, person) — the unique index is what stops a kid from
// re-reading the same card for points. Read credit and quiz credit are
// tracked separately on the same row because they are awarded at different
// moments and either can happen without the other.
model VocabReview {
  id     String    @id @default(cuid())
  word   VocabWord @relation(fields: [wordId], references: [id], onDelete: Cascade)
  wordId String
  user   User      @relation("VocabReviewedBy", fields: [userId], references: [id], onDelete: Cascade)
  userId String

  readAt        DateTime  @default(now())
  quizAttempts  Int       @default(0)
  quizCorrectAt DateTime?

  // Lifetime total for this card (read credit, the first quiz, and every
  // review since). This is what the points balance sums.
  pointsAwarded Int @default(0)

  // Today's share of that total, bucketed by the day it was earned.
  //
  // The daily cap cannot be derived from `pointsAwarded` + `readAt`: a card
  // is always *read* on an earlier day than it is *reviewed* (the shortest
  // interval is one day), so summing by `readAt` attributes review points to
  // the day the word was first seen and lets review earnings bypass the cap
  // completely. `dailyPointsOn` is stored as local midnight in the
  // household's timezone, and the bucket resets the first time a card earns
  // on a new day.
  dailyPoints   Int       @default(0)
  dailyPointsOn DateTime?

  // --- Spaced repetition (SM-2) -------------------------------------------
  // A word passes its first quiz and then enters a review schedule, so it
  // comes back days and weeks later instead of being "learned" once and never
  // seen again. State lives per (word, person) because two kids who learned
  // the same word on the same day forget it at different rates.
  //
  // nextReviewAt is null until the word is first solved — an unsolved card is
  // not "overdue", it simply hasn't entered the schedule yet. It is always
  // stored at local midnight of the household's timezone so "due today" means
  // the same thing here as it does for chores.
  easeFactor     Float     @default(2.5)
  intervalDays   Int       @default(0)
  repetitions    Int       @default(0)
  nextReviewAt   DateTime?
  lastReviewedAt DateTime?
  reviewsPassed  Int       @default(0)
  lapses         Int       @default(0)

  @@unique([wordId, userId])
  @@index([userId])
  // Drives the "what's due for this kid right now" lookup on every dashboard
  // load, which is the single hottest read this feature adds.
  @@index([userId, nextReviewAt])
  // Serves the daily-cap sum, which runs before every single award.
  @@index([userId, dailyPointsOn])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id          String    @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String
  actor       User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId     String?

  action     String
  entityType String
  entityId   String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([householdId, createdAt])
}
