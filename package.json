{
  "name": "smart-household",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "scripts": {
    "dev": "dotenv -e .env -- turbo run dev",
    "build": "dotenv -e .env -- turbo run build",
    "lint": "dotenv -e .env -- turbo run lint",
    "typecheck": "dotenv -e .env -- turbo run typecheck",
    "db:migrate": "dotenv -e .env -- pnpm --filter @household/db migrate",
    "db:seed": "dotenv -e .env -- pnpm --filter @household/db seed",
    "db:studio": "dotenv -e .env -- pnpm --filter @household/db studio"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
