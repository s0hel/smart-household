# Copy to .env and adjust as needed. Local Postgres runs via `docker compose up -d`.
DATABASE_URL="postgresql://household:household@127.0.0.1:5432/household"

# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# Google Calendar sync (Milestone 2). Create an OAuth client at
# https://console.cloud.google.com/apis/credentials (type "Web application"),
# add "<your-app-url>/api/calendar/google/callback" as an authorized redirect
# URI (e.g. http://localhost:3000/api/calendar/google/callback for local dev),
# and enable the Google Calendar API for the project.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Encrypts CalendarAccount access/refresh tokens at rest. Required once any
# calendar provider is connected. Generate with: openssl rand -base64 32
# CALENDAR_TOKEN_ENCRYPTION_KEY=

# AI (morning digest, and future Sidekick/agent work). Provider-agnostic via
# the Vercel AI SDK — swap AI_PROVIDER without touching any code.
# ollama (default): local dev via `ollama serve` (OpenAI-compatible endpoint).
#   Pull a model first, e.g. `ollama pull llama3.2`.
AI_PROVIDER="ollama"
AI_MODEL="llama3.2"
OLLAMA_BASE_URL="http://localhost:11434/v1"
# anthropic: set AI_PROVIDER=anthropic, AI_MODEL=claude-sonnet-5 (or similar)
# ANTHROPIC_API_KEY=
# openai: set AI_PROVIDER=openai, AI_MODEL=gpt-4o-mini (or similar)
# OPENAI_API_KEY=

# Not used yet.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# PUSHER_APP_ID=
# PUSHER_KEY=
# PUSHER_SECRET=
